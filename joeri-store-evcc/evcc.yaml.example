# EVCC configuration template.
#
# Before starting the app for the first time on Umbrel, this file needs to
# exist at <app data dir>/data/evcc.yaml (the docker-compose.yml in this
# folder mounts it to /etc/evcc.yaml inside the container). Copy this
# example there and edit it for your own hardware, or just start the app
# and use its web UI setup wizard instead — either works.
#
# Full reference: https://docs.evcc.io/docs/reference/configuration/

network:
  schema: http
  host: 0.0.0.0
  port: 7070

# Log level: fatal, error, warn, info, debug, trace
log: info

# Interval for status updates
interval: 30s

# Database for statistics (mounted volume, persists across restarts)
database:
  type: sqlite
  dsn: /root/.evcc/evcc.db

# MQTT broker (optional, e.g. for TeslaMate integration)
# mqtt:
#   broker: mosquitto:1883
#   topic: evcc

# Meter configuration - your smart meter / grid connection
meters:
  - name: grid
    type: template
    template: shelly3em  # change to your meter type
    host: 192.168.1.100  # change to your meter IP

  # - name: pv
  #   type: template
  #   template: sma-sunny-boy
  #   uri: http://192.168.1.101

# Charger / wallbox configuration
chargers:
  - name: wallbox
    type: template
    template: go-e  # change to your wallbox type
    host: 192.168.1.200  # change to your wallbox IP

# Vehicle configuration
vehicles:
  - name: my-car
    type: template
    template: tesla  # change to your vehicle brand
    title: My Car
    # username: your@email.com
    # password: yourpassword

# Load points (charging stations)
loadpoints:
  - title: Garage
    charger: wallbox
    vehicle: my-car
    mode: pv          # pv = solar only, minpv = minimum + solar, now = full speed
    minsoc: 20
    targetsoc: 80
    resetOnDisconnect: false

# Site configuration (your home energy setup)
site:
  title: My Home
  meters:
    grid: grid
    # pv: pv
    # battery: bat
